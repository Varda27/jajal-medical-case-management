{
  "info": {
    "_postman_id": "c87c9f80-9281-4321-bf91-b1e19488a002",
    "name": "Jajal Medical Case Management API",
    "description": "Postman Collection for testing Laravel Sanctum API endpoints of the Jajal Medical Case Management System.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login as Admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@jajalmedical.com\",\n  \"password\": \"Admin@12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "login"]
            }
          }
        },
        {
          "name": "Login as Viewer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"viewer@jajalmedical.com\",\n  \"password\": \"Viewer@12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "login"]
            }
          }
        },
        {
          "name": "Logout (Revoke Token)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Medical Cases",
      "item": [
        {
          "name": "List Cases (Paginated & Filtered)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cases?page=1&status=Planning&priority=High&search=CASE",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cases"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "status", "value": "Planning" },
                { "key": "priority", "value": "High" },
                { "key": "search", "value": "CASE" }
              ]
            }
          }
        },
        {
          "name": "Get Single Case By ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cases/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cases", "1"]
            }
          }
        },
        {
          "name": "Create Case (Admin Only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"case_number\": \"CASE-1099\",\n  \"patient_reference\": \"REF-48201\",\n  \"surgeon_name\": \"Dr. Robert Chen\",\n  \"implant_type\": \"Custom Mandibular Reconstruction Plate\",\n  \"status\": \"Planning\",\n  \"priority\": \"High\",\n  \"surgery_date\": \"2026-11-15\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cases",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cases"]
            }
          }
        },
        {
          "name": "Update Case (Admin Only)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"case_number\": \"CASE-1099\",\n  \"patient_reference\": \"REF-48201\",\n  \"surgeon_name\": \"Dr. Robert Chen\",\n  \"implant_type\": \"Custom Mandibular Reconstruction Plate\",\n  \"status\": \"Approved\",\n  \"priority\": \"Medium\",\n  \"surgery_date\": \"2026-11-18\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cases/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cases", "1"]
            }
          }
        },
        {
          "name": "Delete Case (Admin Only - Returns 403 for Viewer)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cases/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cases", "1"]
            }
          }
        }
      ]
    }
  ]
}
